{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "exactOptionalPropertyTypes": false,
    "useUnknownInCatchVariables": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": false,

    "baseUrl": ".",
    "paths": {
      "@pdlc/shared-types": ["packages/shared-types/src/index.ts"],
      "@pdlc/shared-types/*": ["packages/shared-types/src/*"],
      "@pdlc/ui": ["packages/ui/src/index.ts"],
      "@pdlc/ui/*": ["packages/ui/src/*"],
      "@pdlc/config": ["packages/config/src/index.ts"],
      "@pdlc/config/*": ["packages/config/src/*"],
      "@pdlc/connectors": ["packages/connectors/src/index.ts"],
      "@pdlc/connectors/*": ["packages/connectors/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".turbo", "coverage"]
}
