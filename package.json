{
  "name": "pdlc-platform",
  "private": true,
  "version": "0.0.0",
  "description": "Enterprise Product Development Lifecycle platform (monorepo root)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19 <23",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yml,yaml}\"",
    "db:generate": "pnpm --filter @pdlc/api prisma:generate",
    "db:migrate": "pnpm --filter @pdlc/api prisma:migrate",
    "db:seed": "pnpm --filter @pdlc/api prisma:seed",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "prettier": "^3.4.2",
    "husky": "^9.1.7",
    "eslint": "^9.17.0"
  }
}
