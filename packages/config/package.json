{
  "name": "@pdlc/config",
  "version": "0.0.0",
  "private": true,
  "description": "Shared runtime config helpers (Zod env validation) and lint/tsconfig presets",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./eslint": "./eslint-preset.cjs",
    "./tsconfig": "./tsconfig.preset.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.19.0",
    "eslint-config-prettier": "^9.1.0",
    "vitest": "^2.1.8"
  }
}
