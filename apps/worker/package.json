{
  "name": "@pdlc/worker",
  "version": "0.0.0",
  "private": true,
  "description": "PDLC platform background job worker — BullMQ over Redis.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@pdlc/config": "workspace:*",
    "@pdlc/shared-types": "workspace:*",
    "bullmq": "^5.34.4",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "pino": "^9.5.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
