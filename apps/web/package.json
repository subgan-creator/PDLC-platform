    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.62.11",
    "@tanstack/react-router": "^1.92.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "@hookform/resolvers": "^3.9.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.2",
    "recharts": "^2.15.0",
    "reactflow": "^11.11.4",
    "@tiptap/react": "^2.10.4",
    "@tiptap/starter-kit": "^2.10.4"
  },
  "devDependencies": {
