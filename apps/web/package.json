{
  "name": "@pdlc/web",
  "version": "0.0.0",
  "private": true,
  "description": "PDLC platform React app shell.",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "lint": "eslint src e2e --max-warnings=0",
