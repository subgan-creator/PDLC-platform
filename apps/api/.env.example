NODE_ENV=development
LOG_LEVEL=info
PORT=3000

DATABASE_URL=postgresql://pdlc:pdlc@localhost:5432/pdlc?schema=public
REDIS_URL=redis://localhost:6379

DEPLOYMENT_REGION=local

# dev-stub trusts x-dev-user-id / x-dev-tenant-id headers instead of real OIDC.
# Forbidden when NODE_ENV=production (AuthGuard throws at boot).
AUTH_MODE=dev-stub
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_AUDIENCE=

S3_ENDPOINT=http://localhost:4566
S3_BUCKET=pdlc-attachments
S3_REGION=us-east-1

OPENSEARCH_URL=http://localhost:9200

CORS_ORIGIN=http://localhost:5173

OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=pdlc-api
