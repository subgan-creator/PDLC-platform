{
  "name": "@pdlc/api",
  "version": "0.0.0",
  "private": true,
  "description": "PDLC platform API — NestJS, Prisma/Postgres with RLS tenant isolation.",
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "dev": "nodemon --watch src --watch ../../packages --ext ts --exec \"ts-node --files -r tsconfig-paths/register src/main.ts\"",
    "start": "node dist/main.js",
    "lint": "eslint src prisma --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "clean": "rm -rf dist .turbo",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.0",
    "@nestjs/terminus": "^10.2.3",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.53.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.55.0",
    "@opentelemetry/resources": "^1.28.0",
    "@opentelemetry/sdk-node": "^0.55.0",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@pdlc/config": "workspace:*",
    "@pdlc/shared-types": "workspace:*",
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.7",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "nestjs-pino": "^4.3.1",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.3.0",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@swc/core": "1.16.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/uuid": "^10.0.0",
    "@types/webpack-node-externals": "3.0.4",
    "eslint": "^9.17.0",
    "nodemon": "^3.1.9",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-loader": "9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "4.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "unplugin-swc": "1.5.11",
    "vitest": "^2.1.8",
    "webpack": "5.109.2",
    "webpack-node-externals": "3.0.0"
  }
}
