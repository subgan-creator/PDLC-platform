// PDLC platform — Phase 0 foundation schema.
//
// Scope deliberately narrow: Tenant/User/RBAC/Audit/Attachment only. The
// full domain model (Initiative, Discovery, Definition, ...) is
// forward-declared as TypeScript types in packages/shared-types and lands
// in this file phase by phase (A8) via expand/contract migrations — see
// docs/06-adr/ADR-0002 and CLAUDE.md.
//
// TenantScoped base pattern: every tenant-owned table below carries a
// `tenantId` column, a foreign key to `tenants`, an index on `tenantId`,
// AND a Postgres Row-Level Security policy (see the accompanying
// migration.sql) keyed on the `app.tenant_id` session variable set once per
// request by RequestContextMiddleware. Application code must never trust
// the app layer alone to filter by tenant — RLS is the backstop.
//
// New tenant-scoped models MUST repeat this shape:
//   tenantId String
//   tenant   Tenant @relation(fields: [tenantId], references: [id])
//   @@index([tenantId])
// ...and the migration that creates them MUST enable + force RLS with a
// policy scoped to app.tenant_id, following the pattern already in
// prisma/migrations/00000000000000_init/migration.sql.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "audit"]
}

// ---------------------------------------------------------------------------
// Tenancy
// ---------------------------------------------------------------------------

enum TenantStatus {
  ACTIVE
  SUSPENDED
  PROVISIONING
  OFFBOARDING

  @@schema("public")
}

/// Data residency: a tenant's data must never cross this region boundary
/// (A5). Infra provisioning pins storage/DB to the matching region.
enum DataResidencyRegion {
  US
  EU
  UK
  APAC

  @@schema("public")
}

model Tenant {
  id                String              @id @default(uuid())
  name              String
  slug              String              @unique
  status            TenantStatus        @default(PROVISIONING)
  residencyRegion   DataResidencyRegion @default(US)
  /// Reference into the vault/KMS — never the key material itself (BYOK-ready).
  encryptionKeyRef  String?
  retentionPolicyId String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  users       User[]
  roles       Role[]
  userRoles   UserRole[]
  attachments Attachment[]

  productAreas           ProductArea[]
  initiatives            Initiative[]
  outcomeMetrics         OutcomeMetric[]
  hypotheses             Hypothesis[]
  raidItems              RaidItem[]
  milestones             Milestone[]
  statusUpdates          StatusUpdate[]
  initiativeLinks        InitiativeLink[]
  initiativeComments     InitiativeComment[]
  initiativeWatchers     InitiativeWatcher[]
  initiativeStakeholders InitiativeStakeholder[]
  entityVersions         EntityVersion[]
  outboxEvents           OutboxEvent[]

  sources                      Source[]
  evidenceItems                EvidenceItem[]
  insights                     Insight[]
  opportunities                Opportunity[]
  opportunitySolutionTreeNodes OpportunitySolutionTreeNode[]

  @@map("tenants")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

/// The 10 personas from the brief (A2). Selects an RBAC role bundle + view
/// composition — never forks the data model. See CLAUDE.md.
enum Persona {
  PRODUCT_MANAGER
  AREA_PRODUCT_OWNER
  PRODUCT_EXECUTIVE
  DESIGNER
  ENGINEER
  RESEARCHER
  CONTROL_RISK
  GOVERNANCE
  STAKEHOLDER
  SENIOR_MANAGEMENT

  @@schema("public")
}

model User {
  id               String   @id @default(uuid())
  tenantId         String
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  email            String
  displayName      String
  primaryPersona   Persona
  isServiceAccount Boolean  @default(false)
  /// OIDC `sub` claim.
  ssoSubject       String?
  /// SCIM provisioning correlation id.
  scimExternalId   String?
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userRoles UserRole[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@map("users")
  @@schema("public")
}

model Role {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  /// Stable machine key, e.g. "pm", "designer_readonly". Unique per tenant so a tenant can customize.
  key          String
  name         String
  description  String
  personaKey   Persona
  /// Seeded roles cannot be deleted, only cloned.
  isSystemRole Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("roles")
  @@schema("public")
}

enum PermissionAction {
  CREATE
  READ
  UPDATE
  DELETE
  APPROVE
  ATTEST
  EXPORT

  @@schema("public")
}

/// Global catalogue (not tenant-scoped) — the set of resource+action pairs the
/// platform knows how to guard. `@RequirePermission()` checks against this.
model Permission {
  id          String           @id @default(uuid())
  resource    String
  action      PermissionAction
  description String

  rolePermissions RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
  @@schema("public")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
  @@schema("public")
}

model UserRole {
  tenantId           String
  userId             String
  roleId             String
  /// Optional scope narrowing (e.g. this role only applies within one initiative or product area).
  scopeInitiativeId  String?
  scopeProductAreaId String?
  grantedBy          String
  grantedAt          DateTime  @default(now())
  expiresAt          DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([tenantId])
  @@map("user_roles")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Attachments
// ---------------------------------------------------------------------------

enum DataClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  MNPI
  GXP

  @@schema("public")
}

enum VirusScanStatus {
  PENDING
  CLEAN
  INFECTED
  ERROR

  @@schema("public")
}

model Attachment {
  id                 String             @id @default(uuid())
  tenantId           String
  tenant             Tenant             @relation(fields: [tenantId], references: [id])
  /// Polymorphic owner — the entity this file is attached to (e.g. "Story", "Initiative").
  ownerType          String
  ownerId            String
  fileName           String
  mimeType           String
  sizeBytes          Int
  /// S3-compatible object storage key. Never expose a raw bucket URL to clients.
  storageKey         String
  checksumSha256     String
  uploadedBy         String
  dataClassification DataClassification @default(INTERNAL)
  virusScanStatus    VirusScanStatus    @default(PENDING)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([tenantId, ownerType, ownerId])
  @@map("attachments")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Initiative Workspace + Roadmap (Phase 1, A8 / Prompt 1) — the spine.
// ---------------------------------------------------------------------------

/// Portfolio parent hook (nullable) — becomes the Area Product Owner's scope
/// in v2 (Phase 11). Deliberately minimal until then.
model ProductArea {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  key            String
  name           String
  businessLineId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  initiatives Initiative[]

  @@unique([tenantId, key])
  @@index([tenantId])
  @@map("product_areas")
  @@schema("public")
}

enum InitiativePhase {
  DISCOVERY
  DEFINITION
  BUILD
  LAUNCH
  ADOPT
  DONE

  @@schema("public")
}

enum HealthStatus {
  GREEN
  AMBER
  RED

  @@schema("public")
}

enum Confidence {
  LOW
  MEDIUM
  HIGH

  @@schema("public")
}

enum TShirtSize {
  XS
  S
  M
  L
  XL

  @@schema("public")
}

enum RaciRole {
  RESPONSIBLE
  ACCOUNTABLE
  CONSULTED
  INFORMED

  @@schema("public")
}

/// Manual PM placement on the roadmap — distinct from `phase` (lifecycle
/// state) and independent of it; a DONE initiative can still show in Later
/// briefly before someone archives it.
enum RoadmapBucket {
  NOW
  NEXT
  LATER

  @@schema("public")
}

model Initiative {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  title            String
  slug             String
  problemStatement String

  phase        InitiativePhase @default(DISCOVERY)
  health       HealthStatus    @default(GREEN)
  /// Required by the API whenever health != GREEN — enforced in the Zod DTO, not just here.
  healthReason String?
  confidence   Confidence      @default(MEDIUM)
  tshirtSize   TShirtSize      @default(M)

  scope    String
  nonScope String

  plannedStart DateTime?
  plannedEnd   DateTime?
  actualStart  DateTime?
  actualEnd    DateTime?

  ownerId           String
  businessSponsorId String?
  contributingTeams String[]
  tags              String[]

  productAreaId       String?
  productArea         ProductArea? @relation(fields: [productAreaId], references: [id])
  /// Trail preserved from Discovery (JTBD 1) — set when this initiative was
  /// created via `POST /discovery/opportunities/:id/promote`. Distinct from
  /// `promotedOpportunities` below: that's opportunities THIS initiative
  /// absorbed later (should only ever be the one that created it, but
  /// modeled as a relation, not a unique constraint, in case that changes).
  sourceOpportunityId String?
  sourceOpportunity   Opportunity? @relation("InitiativeSourceOpportunity", fields: [sourceOpportunityId], references: [id], onDelete: SetNull)

  roadmapBucket RoadmapBucket?
  roadmapRank   Float?

  /// Forward-declared for v2 governance (Phase 11) — see StageGateStatus in shared-types.
  stageGateStatus    String             @default("not_applicable")
  /// Forward-declared for JTBD 4c control mapping — array of Control ids, none exist until Phase 3.
  controlIds         String[]
  dataClassification DataClassification @default(INTERNAL)

  version    Int       @default(1)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?

  outcomeMetrics        OutcomeMetric[]
  hypotheses            Hypothesis[]
  raidItems             RaidItem[]
  milestones            Milestone[]
  statusUpdates         StatusUpdate[]
  links                 InitiativeLink[]
  comments              InitiativeComment[]
  watchers              InitiativeWatcher[]
  stakeholders          InitiativeStakeholder[]
  /// Back-relation for Opportunity.promotedToInitiativeId (the opposite
  /// direction of sourceOpportunity above).
  promotedOpportunities Opportunity[]           @relation("OpportunityPromotedToInitiative")

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([tenantId, phase])
  @@index([tenantId, productAreaId])
  @@index([tenantId, ownerId])
  @@index([tenantId, roadmapBucket])
  @@map("initiatives")
  @@schema("public")
}

model OutcomeMetric {
  id           String     @id @default(uuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  initiativeId String
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  metricName   String
  baseline     Float?
  target       Float
  current      Float?
  unit         String
  /// Free text today; becomes a connector reference once outcome-metric pull connectors land (A6).
  source       String

  @@index([tenantId, initiativeId])
  @@map("outcome_metrics")
  @@schema("public")
}

model Hypothesis {
  id           String     @id @default(uuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  initiativeId String
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  statement    String
  confidence   Confidence @default(MEDIUM)
  validated    Boolean?

  @@index([tenantId, initiativeId])
  @@map("hypotheses")
  @@schema("public")
}

enum RaidType {
  RISK
  ASSUMPTION
  ISSUE
  DEPENDENCY

  @@schema("public")
}

enum RaidSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@schema("public")
}

enum RaidStatus {
  OPEN
  MITIGATED
  CLOSED

  @@schema("public")
}

model RaidItem {
  id           String     @id @default(uuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  initiativeId String
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  type        RaidType
  description String
  severity    RaidSeverity
  ownerId     String?
  dueDate     DateTime?
  mitigation  String?
  status      RaidStatus   @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, initiativeId])
  @@map("raid_items")
  @@schema("public")
}

enum MilestoneStatus {
  PLANNED
  DONE
  MISSED

  @@schema("public")
}

model Milestone {
  id           String     @id @default(uuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  initiativeId String
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  title       String
  dueDate     DateTime
  status      MilestoneStatus @default(PLANNED)
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, initiativeId])
  @@map("milestones")
  @@schema("public")
}

/// Structured periodic update — the input to the Reporting Studio (Phase 8).
/// Immutable once created: corrections are new rows, never edits.
model StatusUpdate {
  id           String     @id @default(uuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  initiativeId String
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  authoredBy           String
  periodStart          DateTime
  periodEnd            DateTime
  progress             String
  next                 String
  risks                String
  asks                 String
  healthAtTimeOfUpdate HealthStatus
  /// Seam for Phase 9 AI Assist auto-drafting from the last two weeks of activity — null until that exists.
  draftedFromActivity  Json?

  createdAt DateTime @default(now())

  @@index([tenantId, initiativeId])
  @@map("status_updates")
  @@schema("public")
}

enum LinkTargetType {
  EXTERNAL_URL
  STORY
  FIGMA_FRAME
  CONFLUENCE_PAGE
  JIRA_ISSUE
  OTHER

  @@schema("public")
}

model InitiativeLink {
  id           String     @id @default(uuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  initiativeId String
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)

  targetType LinkTargetType
  targetId   String?
  url        String?
  label      String
  createdBy  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, initiativeId])
  @@map("initiative_links")
  @@schema("public")
}

/// Threaded comment with @mentions. `mentionedUserIds` feeds the Unified
/// Inbox once Phase 4 ships; for now it's just stored.
model InitiativeComment {
  id              String              @id @default(uuid())
  tenantId        String
  tenant          Tenant              @relation(fields: [tenantId], references: [id])
  initiativeId    String
  initiative      Initiative          @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  parentCommentId String?
  parentComment   InitiativeComment?  @relation("CommentReplies", fields: [parentCommentId], references: [id])
  replies         InitiativeComment[] @relation("CommentReplies")

  authorId         String
  body             String
  mentionedUserIds String[]

  createdAt DateTime  @default(now())
  editedAt  DateTime?
  deletedAt DateTime?

  @@index([tenantId, initiativeId])
  @@index([tenantId, parentCommentId])
  @@map("initiative_comments")
  @@schema("public")
}

model InitiativeWatcher {
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  initiativeId String
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  userId       String
  createdAt    DateTime   @default(now())

  @@id([initiativeId, userId])
  @@index([tenantId])
  @@map("initiative_watchers")
  @@schema("public")
}

model InitiativeStakeholder {
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id])
  initiativeId String
  initiative   Initiative @relation(fields: [initiativeId], references: [id], onDelete: Cascade)
  userId       String
  raciRole     RaciRole

  @@id([initiativeId, userId, raciRole])
  @@index([tenantId])
  @@map("initiative_stakeholders")
  @@schema("public")
}

/// Full version history with diff & restore (A5). One row per write, whole-
/// record snapshot — diffing happens on read (see VersionsService), not on
/// write, so a new field never needs a migration to old rows.
model EntityVersion {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  entityType    String
  entityId      String
  version       Int
  snapshot      Json
  changedBy     String
  changedAt     DateTime @default(now())
  changeSummary String?

  @@unique([tenantId, entityType, entityId, version])
  @@index([tenantId, entityType, entityId])
  @@map("entity_versions")
  @@schema("public")
}

/// Transactional outbox (A7). Written in the SAME transaction as the
/// mutation it describes — see OutboxService — so an event is never lost
/// even if nothing has consumed it yet (nothing does, until Phase 4).
model OutboxEvent {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  eventType    String
  entityType   String
  entityId     String
  initiativeId String?
  actorUserId  String?
  payload      Json
  occurredAt   DateTime  @default(now())
  processedAt  DateTime?

  @@index([tenantId, occurredAt])
  @@index([tenantId, processedAt])
  @@index([tenantId, initiativeId])
  @@map("outbox_events")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Discovery Hub (Phase 2, A8 / JTBD 1) — Sources -> Evidence -> Insights ->
// Opportunities -> Initiatives, trail preserved. Mirrors
// packages/shared-types/src/discovery.ts field-for-field — see
// docs/03-data-model.md for why that file is the spec.
// ---------------------------------------------------------------------------

enum SourceType {
  INTERVIEW
  SUPPORT_TICKET
  SURVEY
  COMPETITIVE
  DATA_FINDING
  SALES_CALL
  OTHER

  @@schema("public")
}

model Source {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  type                SourceType
  name                String
  /// Voice-of-customer connectors (Qualtrics/Medallia/Intercom/Zendesk) —
  /// no ConnectorInstance model exists until Phase 5, so this is a bare id
  /// with no FK yet, same treatment as Initiative.controlIds before Phase 3.
  connectorInstanceId String?
  externalRef         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidenceItems EvidenceItem[]

  @@index([tenantId])
  @@map("sources")
  @@schema("public")
}

model EvidenceItem {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  sourceId String
  source   Source @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  capturedAt DateTime
  capturedBy String
  content    String
  tags       String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, sourceId])
  @@map("evidence_items")
  @@schema("public")
}

model Insight {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  title           String
  summary         String
  /// Ids into EvidenceItem, not a join table — mirrors the array shape in
  /// shared-types/src/discovery.ts. No DB-level FK on array elements;
  /// InsightsRepository validates each id exists + belongs to the tenant
  /// before writing.
  evidenceItemIds String[]
  tags            String[]
  /// Reuses the existing Confidence enum (Hypothesis/Initiative already use
  /// the same low/medium/high scale) rather than declaring a duplicate.
  confidence      Confidence @default(MEDIUM)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@map("insights")
  @@schema("public")
}

model Opportunity {
  id       String @id @default(uuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  title          String
  problemFraming String
  /// Ids into Insight — same array-not-join-table treatment as
  /// Insight.evidenceItemIds above, for the same reason.
  insightIds     String[]

  promotedToInitiativeId String?
  promotedToInitiative   Initiative? @relation("OpportunityPromotedToInitiative", fields: [promotedToInitiativeId], references: [id], onDelete: SetNull)
  promotedAt             DateTime?
  promotedBy             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  solutionTreeNodes    OpportunitySolutionTreeNode[]
  /// Back-relation for Initiative.sourceOpportunityId.
  sourceForInitiatives Initiative[]                  @relation("InitiativeSourceOpportunity")

  @@index([tenantId])
  @@index([tenantId, promotedToInitiativeId])
  @@map("opportunities")
  @@schema("public")
}

enum SolutionTreeNodeType {
  OUTCOME
  OPPORTUNITY
  SOLUTION
  EXPERIMENT

  @@schema("public")
}

model OpportunitySolutionTreeNode {
  id            String                        @id @default(uuid())
  tenantId      String
  tenant        Tenant                        @relation(fields: [tenantId], references: [id])
  opportunityId String
  opportunity   Opportunity                   @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  /// Restrict, not cascade — deleting a parent node shouldn't silently wipe
  /// its children (same reasoning as InitiativeComment.parentCommentId).
  parentNodeId  String?
  parentNode    OpportunitySolutionTreeNode?  @relation("SolutionTreeChildren", fields: [parentNodeId], references: [id], onDelete: Restrict)
  children      OpportunitySolutionTreeNode[] @relation("SolutionTreeChildren")

  nodeType SolutionTreeNodeType
  label    String

  @@index([tenantId, opportunityId])
  @@index([tenantId, parentNodeId])
  @@map("opportunity_solution_tree_nodes")
  @@schema("public")
}

// ---------------------------------------------------------------------------
// Audit (append-only, separate Postgres schema)
// ---------------------------------------------------------------------------

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  READ_SENSITIVE
  EXPORT
  ATTEST
  SIGN

  @@schema("audit")
}

/// Immutable. Written exclusively by AuditInterceptor — application code
/// must never UPDATE or DELETE a row here. The migration REVOKEs UPDATE/DELETE
/// grants from the app role at the database level as a second backstop.
model AuditEvent {
  id                    String      @id @default(uuid())
  tenantId              String
  actorUserId           String?
  actorServiceAccountId String?
  action                AuditAction
  entityType            String
  entityId              String
  requestId             String
  before                Json?
  after                 Json?
  ipAddress             String?
  userAgent             String?
  occurredAt            DateTime    @default(now())

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, occurredAt])
  @@map("audit_events")
  @@schema("audit")
}
