# engine-strict is off so `pnpm install` doesn't hard-fail on machines still on
# Node 20 — the target runtime is Node 22 (see root package.json "engines" and
# .nvmrc), and CI pins Node 22 explicitly via actions/setup-node, so this only
# relaxes local installs, not what actually ships.
engine-strict=false
auto-install-peers=true
strict-peer-dependencies=false
save-exact=true
